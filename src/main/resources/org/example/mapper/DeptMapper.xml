<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.mapper.DeptMapper">

    <!-- 公共字段片段 -->
    <sql id="deptColumns">dept_id, dept_name, location, manager</sql>

    <!--
        一对多映射：resultMap 中用 <collection> 描述「一个部门包含多个员工」。
        ofType 指定集合中元素的类型（注意是 ofType 而不是 javaType）。
        注意：两表都有 dept_id 列，因此 emp 表的 dept_id 必须用别名 emp_dept_id，
              否则同名列会互相覆盖，导致映射错乱。
    -->
    <resultMap id="deptWithEmpsMap" type="Dept">
        <id     column="dept_id"   property="deptId"/>
        <result column="dept_name" property="deptName"/>
        <result column="location"  property="location"/>
        <result column="manager"   property="manager"/>
        <collection property="emps" ofType="Emp">
            <id     column="emp_id"      property="empId"/>
            <result column="emp_name"    property="empName"/>
            <result column="gender"      property="gender"/>
            <result column="emp_dept"    property="dept"/>
            <result column="emp_dept_id" property="deptId"/>
            <result column="post"        property="post"/>
            <result column="salary"      property="salary"/>
            <result column="hire_date"   property="hireDate"/>
            <result column="status"      property="status"/>
        </collection>
    </resultMap>

    <select id="selectDeptWithEmps" resultMap="deptWithEmpsMap">
        SELECT d.dept_id, d.dept_name, d.location, d.manager,
               e.emp_id, e.emp_name, e.gender,
               e.dept    AS emp_dept,
               e.dept_id AS emp_dept_id,
               e.post, e.salary, e.hire_date, e.status
        FROM dept d
        LEFT JOIN emp e ON d.dept_id = e.dept_id
        ORDER BY d.dept_id, e.emp_id
    </select>

    <!-- 分步查询的目标语句：按主键查部门 -->
    <select id="selectDeptById" resultType="Dept">
        SELECT <include refid="deptColumns"/>
        FROM dept
        WHERE dept_id = #{deptId}
    </select>

</mapper>